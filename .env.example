# Скопируйте в .env. Все значения ниже — значения по умолчанию, файл можно не создавать вовсе.

# --- Чат-модель агента: любой OpenAI-совместимый сервер. По умолчанию — локальный LM Studio.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.5-4b
LLM_TEMPERATURE=0.2
# Цена за миллион токенов в рублях — для подсчёта стоимости ответа. Для локальной модели 0.
LLM_PRICE_IN_RUB=0
LLM_PRICE_OUT_RUB=0
# Облако вместо LM Studio (пример — Polza.ai):
# LLM_BASE_URL=https://polza.ai/api/v1
# LLM_API_KEY=<ключ>
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_PRICE_IN_RUB=5.0
# LLM_PRICE_OUT_RUB=10.1

# --- Эмбеддинги для поиска по смыслу. Пустые адрес и ключ — тот же сервер, что у чат-модели.
EMBED_MODEL=text-embedding-bge-m3
EMBED_BASE_URL=
EMBED_API_KEY=
# Префикс запроса для моделей, которым нужна инструкция (например, qwen3-embedding).
EMBED_QUERY_PREFIX=

# --- Векторная база. Пусто — Qdrant внутри процесса (коллекция в памяти, векторы в кеше на диске).
# С сервером: docker compose up -d qdrant, затем QDRANT_URL=http://localhost:6333
QDRANT_URL=

# --- Предохранители агента и очередь к модели.
MAX_LLM_CALLS=8
RUN_TIMEOUT_S=180
MAX_PARALLEL_RUNS=2
MAX_QUEUE=20

# --- Учёт контекста: окно модели и порог сжатия истории в сводку.
CONTEXT_WINDOW=16384
CONTEXT_COMPACT_TOKENS=10000
CONTEXT_KEEP_EVENTS=8
# Сводку при сжатии модель пишет без рассуждения. Пусто — параметр не передаётся (для облаков без него).
SUMMARY_REASONING_EFFORT=none

# --- Авторизация. Пустой SECRET_KEY — сгенерируется и сохранится в data/.secret.
SECRET_KEY=
SESSION_DAYS=14
COOKIE_SECURE=false

HOST=127.0.0.1
PORT=8000
